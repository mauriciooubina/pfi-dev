# PFI Configuration Settings
HELLFISH_SALT=your_hellfish_salt_here
HOOLIGANS_SALT=your_hooligans_salt_here

# Backend Server configurations
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Data Source Feature Flag ("POSTGRES" or "CSV")
DATA_SOURCE=POSTGRES

# PostgreSQL Database Credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pfi_db
DB_USER=postgres
DB_PASS=postgres
